@{
ViewData["Title"] = "Add Course";
}

<div class="row justify-content-center">


<div class="col-md-8 col-lg-6">

    <div class="mb-4">
        <h1 class="fw-bold">Add Course</h1>

        <p class="text-muted">
            Create a new course and define its capacity.
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div class="mb-4">

                    <label for="title"
                           class="form-label fw-semibold">
                        Course Title
                    </label>

                    <input id="title"
                           name="title"
                           type="text"
                           class="form-control form-control-lg"
                           placeholder="e.g. ASP.NET Core"
                           autocomplete="off"
                           required />

                    @if (ViewData.ModelState["title"]?.Errors.Count > 0)
                    {
                        <div class="text-danger mt-2">
                            @ViewData.ModelState["title"]!.Errors[0].ErrorMessage
                        </div>
                    }

                </div>

                <div class="mb-4">

                    <label for="capacity"
                           class="form-label fw-semibold">
                        Capacity
                    </label>

                    <input id="capacity"
                           name="capacity"
                           type="number"
                           min="1"
                           class="form-control form-control-lg"
                           placeholder="e.g. 30"
                           required />

                    @if (ViewData.ModelState["capacity"]?.Errors.Count > 0)
                    {
                        <div class="text-danger mt-2">
                            @ViewData.ModelState["capacity"]!.Errors[0].ErrorMessage
                        </div>
                    }

                    <div class="form-text">
                        Capacity must be greater than zero.
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light border">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Create Course
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


</div>
