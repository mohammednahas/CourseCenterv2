@model CourseCenterv2.Domain.Entities.Course

@{
ViewData["Title"] = "Edit Course";
}

<div class="row justify-content-center">


<div class="col-md-8 col-lg-6">

    <div class="mb-4">
        <h1 class="fw-bold">Edit Course</h1>

        <p class="text-muted">
            Update course information and capacity.
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="mb-4">

                    <label for="title"
                           class="form-label fw-semibold">
                        Course Title
                    </label>

                    <input id="title"
                           name="title"
                           type="text"
                           value="@Model.Title"
                           class="form-control form-control-lg"
                           autocomplete="off"
                           required />

                    @if (ViewData.ModelState["title"]?.Errors.Count > 0)
                    {
                        <div class="text-danger mt-2">
                            @ViewData.ModelState["title"]!.Errors[0].ErrorMessage
                        </div>
                    }

                </div>

                <div class="mb-4">

                    <label for="capacity"
                           class="form-label fw-semibold">
                        Capacity
                    </label>

                    <input id="capacity"
                           name="capacity"
                           type="number"
                           min="1"
                           value="@Model.Capacity"
                           class="form-control form-control-lg"
                           required />

                    @if (ViewData.ModelState["capacity"]?.Errors.Count > 0)
                    {
                        <div class="text-danger mt-2">
                            @ViewData.ModelState["capacity"]!.Errors[0].ErrorMessage
                        </div>
                    }

                    <div class="form-text">
                        Capacity cannot be lower than the current
                        number of enrolled students.
                    </div>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-light border">
                        Back
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


</div>
