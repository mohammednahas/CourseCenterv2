
@model IReadOnlyList<CourseCenterv2.Domain.Entities.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">Courses</h1>

        <p class="text-muted mb-0">
            Manage available courses and their capacity.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Course
        </a>

        <form asp-action="AddPrefix"
              method="post"
              class="d-inline">

            <button type="submit"
                    class="btn btn-warning">
                Add Advanced to Programming
            </button>

        </form>

        <form asp-action="DeleteProgrammingCourses"
              method="post"
              class="d-inline">

            <button type="submit"
                    class="btn btn-warning">
                Delete Programming Course
            </button>

        </form>

        <a asp-controller="Student" asp-action="Index" class="btn btn-primary">
        Go to students
    </a>


    </div>

</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

            <h5 class="fw-bold">
                No courses found
            </h5>

            <p class="text-muted">
                Start by creating your first course.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Add Course
            </a>

        </div>

    </div>
}
else
{
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">#</th>
                            <th>Course</th>
                            <th>Capacity</th>
                            <th class="text-end pe-4">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                    @foreach (var course in Model)
                    {
                        <tr>

                            <td class="ps-4 text-muted">
                                @course.Id
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @course.Title
                                </div>
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">
                                    @course.Capacity seats
                                </span>
                            </td>

                            <td class="text-end pe-4">

                                <a asp-action="Details"
                                   asp-route-id="@course.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@course.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@course.Id"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this course?');">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}

