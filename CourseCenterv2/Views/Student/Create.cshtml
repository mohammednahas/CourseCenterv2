@{
    ViewData["Title"] = "Add Student";
}

<div class="row justify-content-center">

    <div class="col-md-7 col-lg-6">

        <div class="mb-4">
            <h1 class="fw-bold">Add Student</h1>

            <p class="text-muted">
                Create a new student account.
            </p>
        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    <div class="mb-4">

                        <label for="name"
                               class="form-label fw-semibold">
                            Student Name
                        </label>

                        <input id="name"
                               name="name"
                               type="text"
                               class="form-control form-control-lg"
                               placeholder="Enter student name"
                               autocomplete="off"
                               required />

                        @if (ViewData.ModelState["name"]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-2">
                                @ViewData.ModelState["name"]!.Errors[0].ErrorMessage
                            </div>
                        }

                    </div>

                    <div class="mb-4">

                        <label for="email"
                               class="form-label fw-semibold">
                            Email
                        </label>

                        <input id="email"
                               name="email"
                               type="email"
                               class="form-control form-control-lg"
                               placeholder="Enter student email"
                               autocomplete="off"
                               required />

                        @if (ViewData.ModelState["email"]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-2">
                                @ViewData.ModelState["email"]!.Errors[0].ErrorMessage
                            </div>
                        }

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-light border">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            Create Student
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>