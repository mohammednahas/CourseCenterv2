@model IReadOnlyList<CourseCenterv2.Domain.Entities.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Students</h1>
        <p class="text-muted mb-0">
            Manage students registered in the system.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add Student
    </a>

    <a asp-controller="Course" asp-action="Index" class="btn btn-primary">
        Show Courses
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h5 class="fw-bold">No students found</h5>

            <p class="text-muted">
                Start by adding your first student.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Add Student
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">
                                    @student.Id
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @student.Name
                                    </div>
                                </td>

                                <td>
                                    @student.Email
                                </td>

                                <td class="text-end pe-4">

                                    <a asp-action="Details"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@student.Id"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this student?');">
                                            Delete
                                        </button>

                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}