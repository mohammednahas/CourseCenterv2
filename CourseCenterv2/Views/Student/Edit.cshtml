
@model CourseCenterv2.Domain.Entities.Student

@{
    ViewData["Title"] = "Edit Student";
}

<div class="row justify-content-center">

    <div class="col-md-7 col-lg-6">

        <div class="mb-4">
            <h1 class="fw-bold">Edit Student</h1>

            <p class="text-muted">
                Update the student's information.
            </p>
        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <form asp-action="Edit" method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="mb-4">

                        <label for="firstName"
                               class="form-label fw-semibold">
                            First Name
                        </label>

                        <input id="firstName"
                               name="firstName"
                               type="text"
                               value="@Model.FirstName"
                               class="form-control form-control-lg"
                               autocomplete="off"
                               required />

                        @if (ViewData.ModelState["firstName"]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-2">
                                @ViewData.ModelState["firstName"]!.Errors[0].ErrorMessage
                            </div>
                        }

                    </div>

                    <div class="mb-4">

                        <label for="lastName"
                               class="form-label fw-semibold">
                            Last Name
                        </label>

                        <input id="lastName"
                               name="lastName"
                               type="text"
                               value="@Model.LastName"
                               class="form-control form-control-lg"
                               autocomplete="off"
                               required />

                        @if (ViewData.ModelState["lastName"]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-2">
                                @ViewData.ModelState["lastName"]!.Errors[0].ErrorMessage
                            </div>
                        }

                    </div>

                    <div class="mb-4">

                        <label for="email"
                               class="form-label fw-semibold">
                            Email
                        </label>

                        <input id="email"
                               name="email"
                               type="email"
                               value="@Model.Email"
                               class="form-control form-control-lg"
                               autocomplete="off"
                               required />

                        @if (ViewData.ModelState["email"]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-2">
                                @ViewData.ModelState["email"]!.Errors[0].ErrorMessage
                            </div>
                        }

                    </div>

                    <div class="mb-4">

                        <label for="ssn"
                               class="form-label fw-semibold">
                            SSN
                        </label>

                        <input id="ssn"
                               name="ssn"
                               type="text"
                               value="@Model.SSN"
                               class="form-control form-control-lg"
                               autocomplete="off"
                               required />

                        @if (ViewData.ModelState["ssn"]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-2">
                                @ViewData.ModelState["ssn"]!.Errors[0].ErrorMessage
                            </div>
                        }

                    </div>

                    <div class="mb-4">

                        <label for="address"
                               class="form-label fw-semibold">
                            Address
                        </label>

                        <input id="address"
                               name="address"
                               type="text"
                               value="@Model.Address"
                               class="form-control form-control-lg"
                               autocomplete="off"
                               required />

                        @if (ViewData.ModelState["address"]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-2">
                                @ViewData.ModelState["address"]!.Errors[0].ErrorMessage
                            </div>
                        }

                    </div>

                    <div class="d-flex justify-content-between">

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-light border">
                            Back
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
