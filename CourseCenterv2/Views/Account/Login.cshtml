
@model CourseCenterv2.Models.LoginViewModel

@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول | CourseCenter</title>

    <style>
        :root {
            --primary: #4169e1;
            --primary-dark: #2949ad;
            --navy: #111c3a;
            --text: #202b45;
            --muted: #8993a7;
            --border: #e6eaf2;
            --surface: #ffffff;
            --background: #f3f6fc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                         Tahoma, Arial, sans-serif;
            background: var(--background);
            color: var(--text);
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px;
            overflow: hidden;
            position: relative;
            isolation: isolate;
        }

        .page::before,
        .page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(2px);
            z-index: -1;
            pointer-events: none;
        }

        .page::before {
            width: 460px;
            height: 460px;
            top: -230px;
            right: -100px;
            background: rgba(65, 105, 225, 0.09);
        }

        .page::after {
            width: 400px;
            height: 400px;
            bottom: -230px;
            left: -100px;
            background: rgba(94, 125, 220, 0.10);
        }

        .login-shell {
            width: 100%;
            max-width: 1080px;
            min-height: 650px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: var(--surface);
            border: 1px solid rgba(230, 234, 242, 0.9);
            border-radius: 28px;
            overflow: hidden;
            box-shadow:
                0 30px 80px rgba(24, 42, 85, 0.10),
                0 4px 14px rgba(24, 42, 85, 0.04);
        }

        .brand-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 46px;
            color: white;
            overflow: hidden;
            background:
                radial-gradient(circle at 15% 85%,
                    rgba(111, 151, 255, 0.28), transparent 35%),
                linear-gradient(145deg, #17264e 0%, #203d82 55%, #3158bb 100%);
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            width: 360px;
            height: 360px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
            top: 24%;
            left: -190px;
        }

        .brand-panel::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
            top: 34%;
            left: -135px;
        }

        .brand-top,
        .brand-content,
        .brand-footer {
            position: relative;
            z-index: 1;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .logo-mark {
            width: 49px;
            height: 49px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.13);
            font-size: 23px;
            font-weight: 800;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
        }

        .brand-name {
            font-size: 22px;
            font-weight: 750;
            letter-spacing: -0.5px;
        }

        .brand-caption {
            margin-top: 4px;
            color: #c5d3f7;
            font-size: 12px;
            letter-spacing: 1px;
        }

        .brand-content {
            margin: 60px 0;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 9px 13px;
            border: 1px solid rgba(255, 255, 255, 0.19);
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.08);
            color: #e1e9ff;
            font-size: 12px;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #8ee3c0;
            box-shadow: 0 0 12px rgba(142, 227, 192, 0.7);
        }

        .brand-content h1 {
            margin: 26px 0 18px;
            max-width: 390px;
            font-size: clamp(30px, 3vw, 42px);
            line-height: 1.55;
            letter-spacing: -1px;
        }

        .brand-content p {
            max-width: 380px;
            color: #d0daf4;
            font-size: 15px;
            line-height: 2;
            margin: 0;
        }

        .feature-list {
            margin-top: 32px;
            display: grid;
            gap: 15px;
        }

        .feature {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #edf2ff;
            font-size: 13px;
        }

        .feature-icon {
            display: grid;
            place-items: center;
            width: 30px;
            height: 30px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            font-size: 15px;
        }

        .brand-footer {
            color: #bdcbed;
            font-size: 11px;
            line-height: 1.8;
        }

        .form-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 55px 52px;
            background: #fff;
        }

        .form-content {
            width: 100%;
            max-width: 365px;
        }

        .mobile-logo {
            display: none;
        }

        .welcome-label {
            color: var(--primary);
            font-size: 12px;
            font-weight: 750;
            letter-spacing: 1.2px;
            margin-bottom: 13px;
        }

        .form-content h2 {
            margin: 0;
            font-size: 31px;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: var(--navy);
        }

        .subtitle {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.9;
            margin: 12px 0 33px;
        }

        .field {
            margin-bottom: 21px;
        }

        .field-label {
            display: block;
            margin-bottom: 10px;
            color: #34415d;
            font-size: 13px;
            font-weight: 700;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            right: 16px;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            color: #8c98ad;
            pointer-events: none;
        }

        .form-input {
            width: 100%;
            height: 54px;
            padding: 0 48px 0 15px;
            border: 1px solid var(--border);
            border-radius: 13px;
            outline: none;
            background: #fbfcff;
            color: var(--text);
            font: inherit;
            font-size: 13px;
            transition: border-color .2s ease,
                        box-shadow .2s ease,
                        background .2s ease;
        }

        .form-input::placeholder {
            color: #a4adbd;
        }

        .form-input:hover {
            border-color: #cbd5e8;
        }

        .form-input:focus {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(65, 105, 225, 0.10);
        }

        .field-validation {
            display: block;
            color: #d4384b;
            font-size: 12px;
            margin-top: 7px;
        }

        .validation-summary {
            margin-bottom: 20px;
            padding: 12px 14px;
            border-radius: 10px;
            background: #fff1f2;
            color: #b42335;
            font-size: 12px;
            line-height: 1.8;
        }

        .validation-summary:empty {
            display: none;
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 4px 0 26px;
        }

        .remember {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #68758d;
            font-size: 12px;
            cursor: pointer;
        }

        .remember input {
            width: 16px;
            height: 16px;
            accent-color: var(--primary);
            cursor: pointer;
        }

        .secure-note {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #7b879b;
            font-size: 11px;
        }

        .submit-btn {
            width: 100%;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 0;
            border-radius: 13px;
            background: linear-gradient(110deg, var(--primary), #5279ec);
            color: white;
            font-family: inherit;
            font-size: 14px;
            font-weight: 750;
            cursor: pointer;
            box-shadow: 0 9px 20px rgba(65, 105, 225, 0.23);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 13px 25px rgba(65, 105, 225, 0.30);
        }

        .submit-btn:active {
            transform: translateY(0);
        }

        .submit-arrow {
            font-size: 19px;
            transition: transform .2s ease;
        }

        .submit-btn:hover .submit-arrow {
            transform: translateX(-3px);
        }

        .bottom-note {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 27px;
            color: #929bad;
            font-size: 11px;
            line-height: 1.8;
            text-align: center;
        }

        .bottom-note svg {
            flex-shrink: 0;
            color: #6b83c9;
        }

        @@media (max-width: 800px) {
            .page {
                padding: 20px;
            }

            .login-shell {
                max-width: 500px;
                min-height: auto;
                grid-template-columns: 1fr;
                border-radius: 23px;
            }

            .brand-panel {
                display: none;
            }

            .form-panel {
                padding: 42px 30px;
            }

            .mobile-logo {
                display: flex;
                align-items: center;
                gap: 11px;
                margin-bottom: 35px;
            }

            .mobile-logo .logo-mark {
                color: #fff;
                background: linear-gradient(145deg, #233d85, #5279ec);
                border: none;
            }

            .mobile-logo .brand-name {
                color: var(--navy);
                font-size: 20px;
            }

            .mobile-logo .brand-caption {
                color: #8993a7;
                letter-spacing: 0;
            }

            .form-content h2 {
                font-size: 28px;
            }
        }

        @@media (max-width: 420px) {
            .page {
                padding: 12px;
            }

            .form-panel {
                padding: 32px 21px;
            }

            .form-options {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition: none !important;
            }
        }
    </style>
</head>

<body>
    <main class="page">
        <div class="login-shell">

            <section class="brand-panel">
                <div class="brand-top">
                    <div class="brand-logo">
                        <div class="logo-mark">C</div>
                        <div>
                            <div class="brand-name">CourseCenter</div>
                            <div class="brand-caption">EDUCATION MANAGEMENT SYSTEM</div>
                        </div>
                    </div>
                </div>

                <div class="brand-content">
                    <div class="eyebrow">
                        <span class="eyebrow-dot"></span>
                        منصة الإدارة التعليمية
                    </div>

                    <h1>
                        كل تفاصيل مركزك التعليمي،
                        <span style="color:#a9c1ff;">في مكان واحد.</span>
                    </h1>

                    <p>
                        بيئة عمل منظمة لإدارة بيانات الطلاب والدورات
                        والتسجيلات، من خلال واجهة واضحة وتجربة استخدام سلسة.
                    </p>

                    <div class="feature-list">
                        <div class="feature">
                            <span class="feature-icon">✓</span>
                            إدارة بيانات الطلاب بسهولة
                        </div>
                        <div class="feature">
                            <span class="feature-icon">▦</span>
                            تنظيم الدورات والتسجيلات
                        </div>
                        <div class="feature">
                            <span class="feature-icon">⌑</span>
                            دخول مخصص للموظفين
                        </div>
                    </div>
                </div>

                <div class="brand-footer">
                    CourseCenter Management Portal<br />
                    بيئة إدارية مخصصة لفريق العمل
                </div>
            </section>

            <section class="form-panel">
                <div class="form-content">

                    <div class="mobile-logo">
                        <div class="logo-mark">C</div>
                        <div>
                            <div class="brand-name">CourseCenter</div>
                            <div class="brand-caption">MANAGEMENT PORTAL</div>
                        </div>
                    </div>

                    <div class="welcome-label">مرحباً بعودتك</div>

                    <h2>تسجيل الدخول</h2>

                    <p class="subtitle">
                        سجّل دخولك باستخدام بيانات حساب الموظف
                        للوصول إلى لوحة إدارة المركز.
                    </p>

                    <form asp-controller="Account"
                          asp-action="Login"
                          asp-route-returnUrl="@ViewData["ReturnUrl"]"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary"></div>

                        <div class="field">
                            <label asp-for="Email" class="field-label">
                                البريد الإلكتروني
                            </label>

                            <div class="input-wrap">
                                <svg class="input-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.7"
                                     aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14"
                                          rx="3"></rect>
                                    <path d="m4 7 8 6 8-6"></path>
                                </svg>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-input"
                                       placeholder="name@example.com"
                                       autocomplete="username"
                                       autofocus />
                            </div>

                            <span asp-validation-for="Email"
                                  class="field-validation"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Password" class="field-label">
                                كلمة المرور
                            </label>

                            <div class="input-wrap">
                                <svg class="input-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.7"
                                     aria-hidden="true">
                                    <rect x="4" y="10" width="16" height="11"
                                          rx="3"></rect>
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                    <path d="M12 14v3"></path>
                                </svg>

                                <input asp-for="Password"
                                       class="form-input"
                                       placeholder="أدخل كلمة المرور"
                                       autocomplete="current-password" />
                            </div>

                            <span asp-validation-for="Password"
                                  class="field-validation"></span>
                        </div>

                        <div class="form-options">
                            <label class="remember">
                                <input asp-for="RememberMe" />
                                تذكرني على هذا الجهاز
                            </label>

                            <span class="secure-note">
                                <svg width="14" height="14"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="11"
                                          rx="2"></rect>
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                </svg>
                                دخول آمن
                            </span>
                        </div>

                        <button type="submit" class="submit-btn">
                            <span>تسجيل الدخول إلى النظام</span>
                            <span class="submit-arrow">←</span>
                        </button>
                    </form>

                    <div class="bottom-note">
                        <svg width="16" height="16"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             aria-hidden="true">
                            <path d="M12 3 20 6v5c0 5-3.4 8.2-8 10-4.6-1.8-8-5-8-10V6l8-3Z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                        هذه البوابة مخصصة للموظفين المصرح لهم فقط.
                    </div>

                </div>
            </section>
        </div>
    </main>
</body>
</html>